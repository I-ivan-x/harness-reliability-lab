# Copy to this subproject's .env only if it does not already exist.
# API mode reads only an explicit --model-env file; never commit the key.
LAB_MODEL_API_KEY=
LAB_MODEL_BASE_URL=
LAB_MODEL_NAME=
# Ark Chat: use max_completion_tokens to cap thinking + answer; default max_tokens.
LAB_MODEL_TOKEN_LIMIT_FIELD=max_tokens
